{
  "name": "@ml-vis/core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./workers/cnn-train": {
      "import": "./dist/workers/cnn-train.js"
    },
    "./workers/network-train": {
      "import": "./dist/workers/network-train.js"
    },
    "./workers/mlp-train": {
      "import": "./dist/workers/mlp-train.js"
    },
    "./workers/grad-shard": {
      "import": "./dist/workers/grad-shard.js"
    },
    "./workers/createWorkers": {
      "import": {
        "types": "./dist/workers/createWorkers.d.ts",
        "default": "./dist/workers/createWorkers.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
