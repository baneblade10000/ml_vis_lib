{
  "name": "@ml-vis/core",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./section": {
      "import": { "types": "./dist/section.d.ts", "default": "./dist/section.js" },
      "require": { "types": "./dist/section.d.cts", "default": "./dist/section.cjs" }
    },
    "./signal": {
      "import": { "types": "./dist/signal.d.ts", "default": "./dist/signal.js" },
      "require": { "types": "./dist/signal.d.cts", "default": "./dist/signal.cjs" }
    },
    "./charts": {
      "import": { "types": "./dist/charts.d.ts", "default": "./dist/charts.js" },
      "require": { "types": "./dist/charts.d.cts", "default": "./dist/charts.cjs" }
    },
    "./i18n": {
      "import": { "types": "./dist/i18n.d.ts", "default": "./dist/i18n.js" },
      "require": { "types": "./dist/i18n.d.cts", "default": "./dist/i18n.cjs" }
    },
    "./network": {
      "import": { "types": "./dist/network.d.ts", "default": "./dist/network.js" },
      "require": { "types": "./dist/network.d.cts", "default": "./dist/network.cjs" }
    },
    "./cnn": {
      "import": { "types": "./dist/cnn.d.ts", "default": "./dist/cnn.js" },
      "require": { "types": "./dist/cnn.d.cts", "default": "./dist/cnn.cjs" }
    },
    "./transformer": {
      "import": { "types": "./dist/transformer.d.ts", "default": "./dist/transformer.js" },
      "require": { "types": "./dist/transformer.d.cts", "default": "./dist/transformer.cjs" }
    },
    "./autograd": {
      "import": { "types": "./dist/autograd.d.ts", "default": "./dist/autograd.js" },
      "require": { "types": "./dist/autograd.d.cts", "default": "./dist/autograd.cjs" }
    },
    "./mlp": {
      "import": { "types": "./dist/mlp.d.ts", "default": "./dist/mlp.js" },
      "require": { "types": "./dist/mlp.d.cts", "default": "./dist/mlp.cjs" }
    },
    "./workers": {
      "import": { "types": "./dist/workers.d.ts", "default": "./dist/workers.js" },
      "require": { "types": "./dist/workers.d.cts", "default": "./dist/workers.cjs" }
    },
    "./workers/cnn-train": {
      "import": "./dist/workers/cnn-train.js"
    },
    "./workers/network-train": {
      "import": "./dist/workers/network-train.js"
    },
    "./workers/mlp-train": {
      "import": "./dist/workers/mlp-train.js"
    },
    "./workers/grad-shard": {
      "import": "./dist/workers/grad-shard.js"
    },
    "./workers/createWorkers": {
      "import": {
        "types": "./dist/workers/createWorkers.d.ts",
        "default": "./dist/workers/createWorkers.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
